PORT=80
HOST=0.0.0.0

# Markdown content source used by the static site builder.
# The website branch can contain the site code while the displayed docs come from main.
DOCS_SOURCE_REF=origin/main
DOCS_SOURCE_PATHS=README.md,CONTRIBUTING.md,docs

# Set to true in CI or when you want the builder to refresh origin/main before reading docs.
DOCS_AUTO_FETCH=false
